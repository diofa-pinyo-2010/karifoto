{
  "name": "karifoto",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "prisma generate && if [ \"$VERCEL_ENV\" = \"production\" ]; then prisma migrate deploy; fi && next build",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset --force && prisma db seed",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio --port 5555 --browser none",
    "dev": "next dev",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "postinstall": "prisma generate",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@microsoft/clarity": "^1.0.2",
    "@t3-oss/env-nextjs": "^0.13.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.30.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-player": "^3.4.0",
    "shadcn": "^4.16.2",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vanilla-cookieconsent": "3.1.0"
  },
  "devDependencies": {
    "@bprogress/next": "^3.2.12",
    "@halftome/szamlazz-client": "^3.1.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@t3-oss/env-core": "^0.13.11",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "pg": "^8.23.0",
    "prisma": "7.10.0",
    "resend": "^6.25.0",
    "stripe": "^22.6.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "zod": "^4.5.1"
  },
  "packageManager": "pnpm@9.8.0"
}
