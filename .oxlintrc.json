{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "react",
    "nextjs",
    "jsx-a11y",
    "import"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "no-underscore-dangle": ["warn", { "allow": ["_count"] }],
    "import/no-unassigned-import": [
      "warn",
      { "allow": ["**/*.css", "dotenv/config", "server-only"] }
    ],
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["./*", "../*"],
            "message": "Use an absolute '@/...' import instead of a relative import."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["src/components/ui/**"],
      "rules": { "jsx-a11y/prefer-tag-over-role": "off" }
    }
  ],
  "env": {
    "builtin": true
  }
}
