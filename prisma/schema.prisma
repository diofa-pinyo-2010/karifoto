// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email       String @unique
  name        String
  phoneNumber String

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @default(now()) @updatedAt
  staffProfile  StaffProfile?
  clientProfile ClientProfile?

  magicLinkTokens MagicLinkToken[]
  sessions        Session[]
}

model StaffProfile {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner           User             @relation(fields: [userId], references: [id])
  userId          String           @unique @db.Uuid
  role            StaffProfileRole @default(EDITOR)
  isPhotographer  Boolean          @default(false)
  isEditor        Boolean          @default(false)
  photoShootings  PhotoShooting[]  @relation("Photographer")
  editingSessions PhotoShooting[]  @relation("Editor")

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model ClientProfile {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner            User            @relation(fields: [userId], references: [id])
  userId           String          @unique @db.Uuid
  stripeCustomerId String
  photoShootings   PhotoShooting[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model TimeSlot {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  startTime      DateTime        @db.Timestamptz
  endTime        DateTime        @db.Timestamptz
  revealed       Boolean         @default(false)
  photoShooting  PhotoShooting?
  bookingIntents BookingIntent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model BookingIntent {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  status              BookingIntentStatus @default(PENDING)
  name                String
  email               String
  package             Package
  decorSet            DecorSet?
  isLightPlaySelected Boolean             @default(false)
  numberOfGuests      Int                 @default(0)
  numberOfPets        Int                 @default(0)
  clientNote          String?
  paymentIntent       String? // needed for double payments

  timeSlot   TimeSlot @relation(fields: [timeSlotId], references: [id], onDelete: Restrict)
  timeSlotId String   @db.Uuid

  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @default(now()) @updatedAt
  adjustments PriceAdjustment[]

  @@index([timeSlotId])
}

model PhotoShooting {
  id                  String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  client              ClientProfile @relation(fields: [clientId], references: [id])
  clientId            String        @db.Uuid
  package             Package
  decorSet            DecorSet?
  isLightPlaySelected Boolean       @default(false)
  numberOfGuests      Int           @default(0)
  numberOfPets        Int           @default(0)

  timeSlot   TimeSlot @relation(fields: [timeSlotId], references: [id], onDelete: Restrict)
  timeSlotId String   @unique @db.Uuid

  ledgerEntries LedgerEntry[]
  invoices      Invoice[]
  status        PhotoShootingStatus @default(PHOTOGRAPHER_SELECTION)

  photographer   StaffProfile? @relation("Photographer", fields: [photographerId], references: [id])
  photographerId String?       @db.Uuid

  editor   StaffProfile? @relation("Editor", fields: [editorId], references: [id])
  editorId String?       @db.Uuid

  rawImagesUrl   String?
  finalImagesUrl String?
  clientNote     String?

  closedAt DateTime?

  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @default(now()) @updatedAt
  calendarEvent BookingCalendarEvent?
  pricing       PhotoShootingPricing?
  adjustments   PriceAdjustment[]

  @@index([clientId])
  @@index([photographerId])
  @@index([editorId])
}

model PhotoShootingPricing {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  photoShooting   PhotoShooting @relation(fields: [photoShootingId], references: [id])
  photoShootingId String        @unique @db.Uuid

  packagePriceInCents          Int
  packageStudioPriceInCents    Int
  lightPlayPriceInCents        Int
  packageEditedImagesAllowance Int

  extraPeopleThreshold   Int
  extraPeopleRateInCents Int
  extraPetRateInCents    Int

  extraEditedImageRateInCents    Int
  extraRetouchedImageRateInCents Int

  totalEditedImages    Int @default(0)
  totalRetouchedImages Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model PriceAdjustment {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type          PriceAdjustmentType
  amountInCents Int
  reason        String?

  // One of these will be set, the other null
  bookingIntent   BookingIntent? @relation(fields: [bookingIntentId], references: [id])
  bookingIntentId String?        @db.Uuid

  photoShooting   PhotoShooting? @relation(fields: [photoShootingId], references: [id])
  photoShootingId String?        @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([photoShootingId])
  @@index([bookingIntentId])
}

model BookingCalendarEvent {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  photoShootingId String        @unique @db.Uuid
  photoShooting   PhotoShooting @relation(fields: [photoShootingId], references: [id])

  provider     String   @default("google")
  calendarId   String
  eventId      String
  status       String // created | updated | failed
  lastSyncedAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model LedgerEntry {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  category      LedgerEntryCategory
  amountInCents Int
  currency      Currency            @default(HUF)
  method        PaymentMethod
  paymentIntent String?             @unique

  invoice   Invoice? @relation(fields: [invoiceId], references: [id])
  invoiceId String?  @unique @db.Uuid

  photoShooting   PhotoShooting? @relation(fields: [photoShootingId], references: [id])
  photoShootingId String?        @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([photoShootingId])
}

model Invoice {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceNumber String        @unique
  publicUrl     String
  paymentMethod PaymentMethod
  amountInCents Int
  currency      Currency      @default(HUF)
  status        InvoiceStatus @default(WAITING_FOR_PAYMENT)
  ledgerEntry   LedgerEntry?

  photoShooting   PhotoShooting @relation(fields: [photoShootingId], references: [id])
  photoShootingId String        @db.Uuid

  stornoOf      Invoice? @relation("StornoInvoice", fields: [stornoOfId], references: [id])
  stornoOfId    String?  @unique @db.Uuid
  stornoInvoice Invoice? @relation("StornoInvoice")

  @@index([photoShootingId])
}

model MagicLinkToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner     User      @relation(fields: [userId], references: [id])
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz
  usedAt    DateTime? @db.Timestamptz

  createdAt DateTime @default(now())

  @@index([userId, usedAt, expiresAt])
}

model Session {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner     User     @relation(fields: [userId], references: [id])
  userId    String   @db.Uuid
  tokenHash String   @unique
  expiresAt DateTime @db.Timestamptz

  createdAt DateTime @default(now())

  @@index([userId])
}

enum StaffProfileRole {
  SUPERADMIN
  EDITOR
}

enum PaymentMethod {
  CARD
  TRANSFER // or WIRE?
  CASH
}

enum LedgerEntryCategory {
  INCOME_CLIENT_PAYMENT_DEPOSIT
  INCOME_CLIENT_PAYMENT_BALANCE
  INCOME_CLIENT_PAYMENT_EXTRA
  INCOME_OTHER

  EXPENSE_PHOTOGRAPHER_FEE
  EXPENSE_EDITOR_FEE
  EXPENSE_EQUIPMENT
  EXPENSE_RENT
  EXPENSE_SOFTWARE
  EXPENSE_OTHER
}

enum BookingIntentStatus {
  PENDING
  CONVERTED
  CANCELLED
  PAYMENT_ORPHANED // paid, but the slot was gone – needs a human
}

enum PhotoShootingStatus {
  PHOTOGRAPHER_SELECTION
  WAITING_FOR_THE_DATE
  RAW_PHOTOS_UPLOAD
  USER_SELECTION
  EDITOR_SELECTION
  FINAL_PHOTOS_UPLOAD
  WAITING_FOR_PAYMENT
  COMPLETED
  CLOSED
}

enum Currency {
  HUF
  EUR
  USD
}

enum InvoiceStatus {
  WAITING_FOR_PAYMENT
  SETTLED
  REFUNDED
}

enum PriceAdjustmentType {
  DISCOUNT
  DEDUCTION
}

enum Package {
  MINI
  CLASSIC
  FAMILY
}

enum DecorSet {
  HOFEHER
  ALOMKASTELY
}
