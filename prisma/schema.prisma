// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email       String @unique
  name        String
  phoneNumber String

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @default(now()) @updatedAt
  staffProfile  StaffProfile?
  clientProfile ClientProfile?

  magicLinkTokens    MagicLinkToken[]
  sessions           Session[]
  clientPortalTokens ClientPortalToken[]
}

model StaffProfile {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner            User              @relation(fields: [userId], references: [id])
  userId           String            @unique @db.Uuid
  role             StaffProfileRole  @default(MEMBER)
  nickname         String
  isPhotographer   Boolean           @default(false)
  isEditor         Boolean           @default(false)
  isDefaultEditor  Boolean           @default(false) // at most one true row, enforced by a hand-added partial unique index in the migration SQL
  photoShootings   PhotoShooting[]   @relation("Photographer")
  editings         PhotoShooting[]   @relation("Editor")
  priceAdjustments PriceAdjustment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model ClientProfile {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner            User            @relation(fields: [userId], references: [id])
  userId           String          @unique @db.Uuid
  stripeCustomerId String
  photoShootings   PhotoShooting[]

  billingAddresses   BillingAddress[]
  sentEmails         SentEmail[]
  marketingConsentAt DateTime?        @db.Timestamptz()

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model TimeSlot {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  startTime      DateTime        @db.Timestamptz
  endTime        DateTime        @db.Timestamptz
  revealed       Boolean         @default(false)
  photoShooting  PhotoShooting?
  bookingIntents BookingIntent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model BookingIntent {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  status              BookingIntentStatus @default(PENDING)
  name                String
  email               String
  package             Package
  decorSet            DecorSet?
  isLightPlaySelected Boolean             @default(false)
  numberOfGuests      Int                 @default(0)
  numberOfPets        Int                 @default(0)
  clientNote          String?
  paymentIntent       String? // needed for double payments

  // The time the client picked, kept as a value so it survives the slot row.
  // `timeSlot` is the live hold on that slot and only matters while PENDING —
  // once the intent is converted or cancelled the slot may be deleted and this
  // pointer goes null. Read `requestedStartTime` for history, never `timeSlot`.
  requestedStartTime DateTime  @db.Timestamptz
  timeSlot           TimeSlot? @relation(fields: [timeSlotId], references: [id], onDelete: SetNull)
  timeSlotId         String?   @db.Uuid

  photoShooting PhotoShooting?

  billingAddress            BillingAddress?
  adjustments               PriceAdjustment[]
  optOutFromMarketingEmails Boolean           @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([timeSlotId])
}

model BillingAddress {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String // invoicing name from Stripe checkout — can differ from the client's own name
  zip          String
  city         String
  addressLine1 String

  bookingIntent   BookingIntent? @relation(fields: [bookingIntentId], references: [id], onDelete: SetNull)
  bookingIntentId String?        @unique @db.Uuid

  clientProfile   ClientProfile? @relation(fields: [clientProfileId], references: [id], onDelete: SetNull)
  clientProfileId String?        @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([clientProfileId])
}

model PhotoShooting {
  id                  String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  client              ClientProfile @relation(fields: [clientId], references: [id])
  clientId            String        @db.Uuid
  package             Package
  decorSet            DecorSet?
  isLightPlaySelected Boolean       @default(false)
  numberOfGuests      Int           @default(0)
  numberOfPets        Int           @default(0)

  timeSlot   TimeSlot @relation(fields: [timeSlotId], references: [id], onDelete: Restrict)
  timeSlotId String   @unique @db.Uuid

  bookingIntent   BookingIntent? @relation(fields: [bookingIntentId], references: [id])
  bookingIntentId String?        @unique @db.Uuid

  ledgerEntries LedgerEntry[]
  invoices      Invoice[]
  status        PhotoShootingStatus @default(PHOTOGRAPHER_SELECTION)

  photographer   StaffProfile? @relation("Photographer", fields: [photographerId], references: [id])
  photographerId String?       @db.Uuid

  editor   StaffProfile? @relation("Editor", fields: [editorId], references: [id])
  editorId String?       @db.Uuid

  selectionRequestedAt    DateTime? @db.Timestamptz()
  selectionCompletedAt    DateTime? @db.Timestamptz()
  declaredEditedImages    Int?
  declaredRetouchedImages Int?
  totalEditedImages       Int       @default(0)
  totalRetouchedImages    Int       @default(0)

  rawImagesUrl   String?
  finalImagesUrl String?
  clientNote     String?

  completedAt DateTime? @db.Timestamptz()
  cancelledAt DateTime? @db.Timestamptz()

  calendarEvent BookingCalendarEvent?
  pricing       PhotoShootingPricing?
  adjustments   PriceAdjustment[]
  sentEmails    SentEmail[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([clientId])
  @@index([photographerId])
  @@index([editorId])
}

model PhotoShootingPricing {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  photoShooting   PhotoShooting @relation(fields: [photoShootingId], references: [id])
  photoShootingId String        @unique @db.Uuid

  packagePriceInCents          Int
  packageStudioPriceInCents    Int
  lightPlayPriceInCents        Int
  packageEditedImagesAllowance Int

  extraPeopleThreshold   Int
  extraPeopleRateInCents Int
  extraPetRateInCents    Int

  extraEditedImageRateInCents    Int
  extraRetouchedImageRateInCents Int

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model PriceAdjustment {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type          PriceAdjustmentType
  amountInCents Int
  publicLabel   String
  internalNote  String

  createdBy   StaffProfile? @relation(fields: [createdById], references: [id])
  createdById String?       @db.Uuid

  // One of these will be set, the other null
  bookingIntent   BookingIntent? @relation(fields: [bookingIntentId], references: [id], onDelete: Cascade)
  bookingIntentId String?        @db.Uuid

  photoShooting   PhotoShooting? @relation(fields: [photoShootingId], references: [id], onDelete: Cascade)
  photoShootingId String?        @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([photoShootingId])
  @@index([bookingIntentId])
  @@index([createdById])
}

model BookingCalendarEvent {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  photoShootingId String        @unique @db.Uuid
  photoShooting   PhotoShooting @relation(fields: [photoShootingId], references: [id])

  provider     String   @default("google")
  calendarId   String
  eventId      String
  status       String // created | updated | failed
  lastSyncedAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model LedgerEntry {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  category      LedgerEntryCategory
  amountInCents Int
  currency      Currency            @default(HUF)
  method        PaymentMethod
  paymentIntent String?             @unique

  invoice   Invoice? @relation(fields: [invoiceId], references: [id])
  invoiceId String?  @unique @db.Uuid

  photoShooting   PhotoShooting? @relation(fields: [photoShootingId], references: [id])
  photoShootingId String?        @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([photoShootingId])
}

model Invoice {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceNumber String        @unique
  publicUrl     String
  type          InvoiceType
  amountInCents Int
  status        InvoiceStatus @default(WAITING_FOR_PAYMENT)
  ledgerEntry   LedgerEntry?

  photoShooting   PhotoShooting @relation(fields: [photoShootingId], references: [id])
  photoShootingId String        @db.Uuid

  stornoOf      Invoice? @relation("StornoInvoice", fields: [stornoOfId], references: [id])
  stornoOfId    String?  @unique @db.Uuid
  stornoInvoice Invoice? @relation("StornoInvoice")

  advanceInvoice   Invoice? @relation("FinalInvoice", fields: [advanceInvoiceId], references: [id])
  advanceInvoiceId String?  @unique @db.Uuid
  finalInvoice     Invoice? @relation("FinalInvoice")

  @@index([photoShootingId])
}

model SentEmail {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  resendId  String    @unique
  type      EmailType
  to        String
  subject   String
  variables Json      @default("{}")

  client   ClientProfile? @relation(fields: [clientId], references: [id])
  clientId String?        @db.Uuid

  photoShooting   PhotoShooting? @relation(fields: [photoShootingId], references: [id])
  photoShootingId String?        @db.Uuid

  sentAt DateTime @default(now()) @db.Timestamptz()

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([clientId])
  @@index([photoShootingId])
}

model SiteSettings {
  id                        String  @id @default("singleton")
  automaticEarlyBirdEnabled Boolean @default(false)

  updatedAt DateTime @default(now()) @updatedAt
}

// Auth
model MagicLinkToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner     User      @relation(fields: [userId], references: [id])
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz
  usedAt    DateTime? @db.Timestamptz

  createdAt DateTime @default(now())

  @@index([userId, usedAt, expiresAt])
}

model Session {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner     User        @relation(fields: [userId], references: [id])
  userId    String      @db.Uuid
  tokenHash String      @unique
  expiresAt DateTime    @db.Timestamptz
  // Admin and client sessions are otherwise identical rows. The DAL filters on
  // this so a token minted for one side can never resolve on the other.
  kind      SessionKind @default(ADMIN)

  createdAt DateTime @default(now())

  @@index([userId])
}

// The client portal's bootstrap credential. Deliberately NOT shaped like
// `MagicLinkToken`: no `usedAt`, long expiry, and the verify route never claims
// it — clients must be able to click the link in their confirmation email again
// from a new device or after clearing cookies. See the Phase 2 section of
// src/docs/admin-auth-guide.md.
model ClientPortalToken {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner     User     @relation(fields: [userId], references: [id])
  userId    String   @db.Uuid
  tokenHash String   @unique
  expiresAt DateTime @db.Timestamptz

  createdAt DateTime @default(now())

  @@index([userId])
}

enum SessionKind {
  ADMIN
  CLIENT
}

enum StaffProfileRole {
  SUPERADMIN
  MEMBER
}

enum PaymentMethod {
  CARD
  TRANSFER // or WIRE?
  CASH
}

enum LedgerEntryCategory {
  INCOME_CLIENT_PAYMENT_DEPOSIT
  INCOME_CLIENT_PAYMENT_BALANCE
  INCOME_CLIENT_PAYMENT_EXTRA
  INCOME_OTHER

  EXPENSE_PHOTOGRAPHER_FEE
  EXPENSE_EDITOR_FEE
  EXPENSE_EQUIPMENT
  EXPENSE_RENT
  EXPENSE_SOFTWARE
  EXPENSE_OTHER
}

enum BookingIntentStatus {
  PENDING
  CONVERTED
  CANCELLED
  PAYMENT_ORPHANED // paid, but the slot was gone – needs a human
}

enum PhotoShootingStatus {
  PHOTOGRAPHER_SELECTION
  WAITING_FOR_THE_DATE
  WAITING_FOR_BALANCE_PAYMENT
  RAW_PHOTOS_UPLOAD
  USER_SELECTION
  EDITOR_SELECTION
  FINAL_PHOTOS_UPLOAD
  WAITING_FOR_EXTRA_PAYMENT
  READY_TO_COMPLETE
  COMPLETED
  CANCELLED
}

enum Currency {
  HUF
  EUR
  USD
}

enum InvoiceType {
  NORMAL
  ADVANCE // előlegszámla
  FINAL // végszámla
  STORNO
}

enum InvoiceStatus {
  WAITING_FOR_PAYMENT
  SETTLED
  REFUNDED
}

enum PriceAdjustmentType {
  DISCOUNT
  DEDUCTION
}

enum Package {
  MINI
  CLASSIC
  FAMILY
  PARTY
}

enum DecorSet {
  HOFEHER
  RETRO
}

// Client emails only — admin emails are never recorded in SentEmail.
enum EmailType {
  CLIENT_BOOKING_CONFIRMATION
  DEPOSIT_REQUEST
  REMINDER_ON_THE_DAY
  RESCHEDULE_NOTIFICATION
  IMAGE_SELECTION
}
