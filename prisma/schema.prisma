// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email       String @unique
  name        String
  phoneNumber String

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @default(now()) @updatedAt
  staffProfile  StaffProfile?
  clientProfile ClientProfile?

  magicLinkTokens    MagicLinkToken[]
  sessions           Session[]
  clientPortalTokens ClientPortalToken[]
}

model StaffProfile {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner            User              @relation(fields: [userId], references: [id])
  userId           String            @unique @db.Uuid
  role             StaffProfileRole  @default(MEMBER)
  nickname         String
  isPhotographer   Boolean           @default(false)
  isEditor         Boolean           @default(false)
  isDefaultEditor  Boolean           @default(false) // at most one true row, enforced by a hand-added partial unique index in the migration SQL
  photoShootings   PhotoShooting[]   @relation("Photographer")
  editings         PhotoShooting[]   @relation("Editor")
  priceAdjustments PriceAdjustment[]
  comments         Comment[]
  commentMentions  CommentMention[]
  feePayouts       LedgerEntry[]
  reviewStands     ReviewStand[]
  reviewTaps       ReviewTap[]
  staffPayouts     StaffPayout[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model ClientProfile {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner            User            @relation(fields: [userId], references: [id])
  userId           String          @unique @db.Uuid
  stripeCustomerId String
  photoShootings   PhotoShooting[]

  billingAddresses   BillingAddress[]
  sentEmails         SentEmail[]
  marketingConsentAt DateTime?        @db.Timestamptz()

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model TimeSlot {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  startTime       DateTime        @db.Timestamptz
  endTime         DateTime        @db.Timestamptz
  revealed        Boolean         @default(false)
  allowedPackages Package[]       @default([]) // empty = all allowed
  photoShooting   PhotoShooting?
  bookingIntents  BookingIntent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model BookingIntent {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  status              BookingIntentStatus @default(PENDING)
  name                String
  email               String
  package             Package
  decorSet            DecorSet?
  isLightPlaySelected Boolean             @default(false)
  numberOfGuests      Int                 @default(0)
  numberOfPets        Int                 @default(0)
  clientNote          String?
  paymentIntent       String? // needed for double payments

  // The time the client picked, kept as a value so it survives the slot row.
  // `timeSlot` is the live hold on that slot and only matters while PENDING —
  // once the intent is converted or cancelled the slot may be deleted and this
  // pointer goes null. Read `requestedStartTime` for history, never `timeSlot`.
  requestedStartTime DateTime  @db.Timestamptz
  timeSlot           TimeSlot? @relation(fields: [timeSlotId], references: [id], onDelete: SetNull)
  timeSlotId         String?   @db.Uuid

  photoShooting PhotoShooting?

  billingAddress            BillingAddress?
  adjustments               PriceAdjustment[]
  optOutFromMarketingEmails Boolean           @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([timeSlotId])
}

model BillingAddress {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String // invoicing name from Stripe checkout — can differ from the client's own name
  zip          String
  city         String
  addressLine1 String

  bookingIntent   BookingIntent? @relation(fields: [bookingIntentId], references: [id], onDelete: SetNull)
  bookingIntentId String?        @unique @db.Uuid

  clientProfile   ClientProfile? @relation(fields: [clientProfileId], references: [id], onDelete: SetNull)
  clientProfileId String?        @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([clientProfileId])
}

model PhotoShooting {
  id                  String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  client              ClientProfile @relation(fields: [clientId], references: [id])
  clientId            String        @db.Uuid
  package             Package
  decorSet            DecorSet?
  isLightPlaySelected Boolean       @default(false)
  numberOfGuests      Int           @default(0)
  numberOfPets        Int           @default(0)

  timeSlot   TimeSlot @relation(fields: [timeSlotId], references: [id], onDelete: Restrict)
  timeSlotId String   @unique @db.Uuid

  bookingIntent   BookingIntent? @relation(fields: [bookingIntentId], references: [id])
  bookingIntentId String?        @unique @db.Uuid

  ledgerEntries LedgerEntry[]
  invoices      Invoice[]
  status        PhotoShootingStatus @default(PHOTOGRAPHER_SELECTION)

  photographer   StaffProfile? @relation("Photographer", fields: [photographerId], references: [id])
  photographerId String?       @db.Uuid

  editor   StaffProfile? @relation("Editor", fields: [editorId], references: [id])
  editorId String?       @db.Uuid

  selectionRequestedAt    DateTime? @db.Timestamptz()
  selectionCompletedAt    DateTime? @db.Timestamptz()
  declaredEditedImages    Int?
  declaredRetouchedImages Int?
  totalEditedImages       Int       @default(0)
  totalRetouchedImages    Int       @default(0)
  isExpressPostProduction Boolean   @default(false)
  beautyRetouchNotes      String?

  rawImagesUrl   String?
  finalImagesUrl String?
  clientNote     String?

  completedAt DateTime? @db.Timestamptz()
  cancelledAt DateTime? @db.Timestamptz()

  calendarEvent         BookingCalendarEvent?
  pricing               PhotoShootingPricing?
  adjustments           PriceAdjustment[]
  sentEmails            SentEmail[]
  comments              Comment[]
  sumupCheckoutAttempts SumupCheckoutAttempt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([clientId])
  @@index([photographerId])
  @@index([editorId])
}

model PhotoShootingPricing {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  photoShooting   PhotoShooting @relation(fields: [photoShootingId], references: [id])
  photoShootingId String        @unique @db.Uuid

  packagePriceInCents          Int
  packageStudioPriceInCents    Int
  lightPlayPriceInCents        Int
  packageEditedImagesAllowance Int

  extraPeopleThreshold   Int
  extraPeopleRateInCents Int
  extraPetRateInCents    Int

  extraEditedImageRateInCents       Int
  extraRetouchedImageRateInCents    Int
  expressPostProductionPriceInCents Int @default(1000000)

  // What the studio pays staff, not what the client pays.
  photographerPackageFeeInCents     Int
  photographerLightPlayFeeInCents   Int
  photographerExtraPersonFeeInCents Int
  photographerPetFeeInCents         Int
  editorEditedImageFeeInCents       Int
  editorRetouchedImageFeeInCents    Int

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model PriceAdjustment {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type          PriceAdjustmentType
  amountInCents Int
  publicLabel   String
  internalNote  String

  createdBy   StaffProfile? @relation(fields: [createdById], references: [id])
  createdById String?       @db.Uuid

  // One of these will be set, the other null
  bookingIntent   BookingIntent? @relation(fields: [bookingIntentId], references: [id], onDelete: Cascade)
  bookingIntentId String?        @db.Uuid

  photoShooting   PhotoShooting? @relation(fields: [photoShootingId], references: [id], onDelete: Cascade)
  photoShootingId String?        @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([photoShootingId])
  @@index([bookingIntentId])
  @@index([createdById])
}

// Internal, staff-only note. Generic on purpose: each possible owner gets its own
// nullable FK, and the hand-added `comment_one_owner` CHECK in the migration SQL
// enforces that exactly one is set. Adding an owner means extending that CHECK.
model Comment {
  id   String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  body String

  // Null once the staff member is deleted; the UI then shows "Törölt munkatárs"
  author   StaffProfile? @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorId String?       @db.Uuid

  // Cascade, not SetNull: an ownerless row would violate the CHECK
  photoShooting   PhotoShooting?   @relation(fields: [photoShootingId], references: [id], onDelete: Cascade)
  photoShootingId String?          @db.Uuid
  mentions        CommentMention[]

  createdAt DateTime @default(now()) @db.Timestamptz()
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz()

  @@index([photoShootingId, createdAt])
  @@index([authorId])
}

model CommentMention {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  commentId String  @db.Uuid

  staffProfile   StaffProfile @relation(fields: [staffProfileId], references: [id], onDelete: Cascade)
  staffProfileId String       @db.Uuid
  notifiedAt     DateTime?    @db.Timestamptz()

  createdAt DateTime @default(now()) @db.Timestamptz()

  @@unique([commentId, staffProfileId])
  @@index([staffProfileId])
}

model BookingCalendarEvent {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  photoShootingId String        @unique @db.Uuid
  photoShooting   PhotoShooting @relation(fields: [photoShootingId], references: [id])

  provider     String   @default("google")
  calendarId   String
  eventId      String
  status       String // created | updated | failed
  lastSyncedAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model LedgerEntry {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  category      LedgerEntryCategory
  amountInCents Int
  currency      Currency            @default(HUF)
  method        PaymentMethod
  paymentIntent String?             @unique
  description   String?

  invoice   Invoice? @relation(fields: [invoiceId], references: [id])
  invoiceId String?  @unique @db.Uuid

  photoShooting   PhotoShooting? @relation(fields: [photoShootingId], references: [id])
  photoShootingId String?        @db.Uuid

  // The staff member a fee payout went to (EXPENSE_PHOTOGRAPHER_FEE / EXPENSE_EDITOR_FEE / EXPENSE_STAFF_BONUS).
  staffProfile   StaffProfile? @relation(fields: [staffProfileId], references: [id])
  staffProfileId String?       @db.Uuid

  // The payout this row is one slice of; a payout is split FIFO over the items it covers.
  staffPayout   StaffPayout? @relation(fields: [staffPayoutId], references: [id], onDelete: Restrict)
  staffPayoutId String?      @db.Uuid

  // The review tap an EXPENSE_STAFF_BONUS row pays for.
  reviewTap   ReviewTap? @relation(fields: [reviewTapId], references: [id], onDelete: Restrict)
  reviewTapId String?    @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([photoShootingId])
  @@index([staffProfileId])
  @@index([staffPayoutId])
  @@index([reviewTapId])
}

// One payout handed to a staff member. Its money lives in the LedgerEntry rows
// it is split into, one per fee or bonus it covers.
model StaffPayout {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  staffProfile   StaffProfile  @relation(fields: [staffProfileId], references: [id])
  staffProfileId String        @db.Uuid
  amountInCents  Int // positive: the whole amount paid out
  method         PaymentMethod
  note           String?
  ledgerEntries  LedgerEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([staffProfileId, createdAt])
}

model Invoice {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceNumber String        @unique
  publicUrl     String
  type          InvoiceType
  amountInCents Int
  status        InvoiceStatus @default(WAITING_FOR_PAYMENT)
  ledgerEntry   LedgerEntry?

  photoShooting   PhotoShooting @relation(fields: [photoShootingId], references: [id])
  photoShootingId String        @db.Uuid

  stornoOf      Invoice? @relation("StornoInvoice", fields: [stornoOfId], references: [id])
  stornoOfId    String?  @unique @db.Uuid
  stornoInvoice Invoice? @relation("StornoInvoice")

  advanceInvoice   Invoice? @relation("FinalInvoice", fields: [advanceInvoiceId], references: [id])
  advanceInvoiceId String?  @unique @db.Uuid
  finalInvoice     Invoice? @relation("FinalInvoice")

  @@index([photoShootingId])
}

model SumupCheckoutAttempt {
  id                  String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  status              SumupCheckoutAttemptStatus @default(INITIATED)
  clientTransactionId String?                    @unique
  checkoutId          String?
  failureReason       String?
  amountInCents       Int
  // A reader, amelyre a checkout indult; a leállítás is ide megy. A korábbi
  // kísérleteknél null.
  readerId            String?

  photoShooting   PhotoShooting @relation(fields: [photoShootingId], references: [id])
  photoShootingId String        @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([photoShootingId])
}

model SentEmail {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  resendId  String    @unique
  type      EmailType
  to        String
  subject   String
  variables Json      @default("{}")

  client   ClientProfile? @relation(fields: [clientId], references: [id])
  clientId String?        @db.Uuid

  photoShooting   PhotoShooting? @relation(fields: [photoShootingId], references: [id])
  photoShootingId String?        @db.Uuid

  sentAt DateTime @default(now()) @db.Timestamptz()

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([clientId])
  @@index([photoShootingId])
}

model SiteSettings {
  id                        String  @id @default("singleton")
  automaticEarlyBirdEnabled Boolean @default(false)
  // A Terminálok oldalon kiválasztott SumUp reader, erre indul a fizetés.
  sumupReaderId             String?
  // Napi váltó: a kasszában reggel hagyott készpénz. Egyetlen, bármikor
  // felülírható érték, nincs napokra bontott története.
  dailyChangeInCents        Int     @default(0)
  // Az early bird / last minute határnap: az ennél a napnál (budapesti éjfél)
  // korábban kezdődő idősávok számítanak early birdnek. Csak nap, idő nélkül;
  // null → nincs early bird időszak.
  earlyBirdDeadline         DateTime? @db.Date

  updatedAt DateTime @default(now()) @updatedAt
}

// One physical NFC/QR stand. The id is printed into its link (/r/<id>), so a
// stand keeps working when it moves to another photographer.
model ReviewStand {
  id    String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  label String

  staffProfile   StaffProfile? @relation(fields: [staffProfileId], references: [id])
  staffProfileId String?       @db.Uuid

  active Boolean     @default(true)
  taps   ReviewTap[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([staffProfileId])
}

// A tap is someone opening a stand's link, not a review. It earns a bonus only
// once staff paste a 5-star review's URL onto it. Restrict on both relations:
// with a bonus on it this row is a money record.
model ReviewTap {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  stand          ReviewStand   @relation(fields: [standId], references: [id], onDelete: Restrict)
  standId        String        @db.Uuid
  // The stand's photographer at the moment of the tap, not the current one.
  staffProfile   StaffProfile? @relation(fields: [staffProfileId], references: [id], onDelete: Restrict)
  staffProfileId String?       @db.Uuid

  channel TapChannel?

  // Snapshotted together with reviewUrl, so changing the bonus later leaves past ones alone.
  bonusInCents   Int?
  reviewUrl      String?   @unique
  reviewUrlSetAt DateTime? @db.Timestamptz()

  ledgerEntries LedgerEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([staffProfileId, createdAt])
  @@index([standId, createdAt])
}

// Auth
model MagicLinkToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner     User      @relation(fields: [userId], references: [id])
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz
  usedAt    DateTime? @db.Timestamptz

  createdAt DateTime @default(now())

  @@index([userId, usedAt, expiresAt])
}

model Session {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner     User        @relation(fields: [userId], references: [id])
  userId    String      @db.Uuid
  tokenHash String      @unique
  expiresAt DateTime    @db.Timestamptz
  // Admin and client sessions are otherwise identical rows. The DAL filters on
  // this so a token minted for one side can never resolve on the other.
  kind      SessionKind @default(ADMIN)

  createdAt DateTime @default(now())

  @@index([userId])
}

// The client portal's bootstrap credential. Deliberately NOT shaped like
// `MagicLinkToken`: no `usedAt`, long expiry, and the verify route never claims
// it — clients must be able to click the link in their confirmation email again
// from a new device or after clearing cookies. See the Phase 2 section of
// src/docs/admin-auth-guide.md.
model ClientPortalToken {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner     User     @relation(fields: [userId], references: [id])
  userId    String   @db.Uuid
  tokenHash String   @unique
  expiresAt DateTime @db.Timestamptz

  createdAt DateTime @default(now())

  @@index([userId])
}

enum SessionKind {
  ADMIN
  CLIENT
}

enum TapChannel {
  NFC
  QR
}

enum StaffProfileRole {
  SUPERADMIN
  MEMBER
}

enum PaymentMethod {
  CARD
  TRANSFER // or WIRE?
  CASH
}

enum LedgerEntryCategory {
  INCOME_CLIENT_PAYMENT_DEPOSIT
  INCOME_CLIENT_PAYMENT_BALANCE
  INCOME_CLIENT_PAYMENT_EXTRA
  INCOME_OTHER

  EXPENSE_PHOTOGRAPHER_FEE
  EXPENSE_EDITOR_FEE
  EXPENSE_STAFF_BONUS
  EXPENSE_EQUIPMENT
  EXPENSE_RENT
  EXPENSE_SOFTWARE
  EXPENSE_OTHER
}

enum BookingIntentStatus {
  PENDING
  CONVERTED
  CANCELLED
  PAYMENT_ORPHANED // paid, but the slot was gone – needs a human
}

enum PhotoShootingStatus {
  PHOTOGRAPHER_SELECTION
  WAITING_FOR_THE_DATE
  WAITING_FOR_BALANCE_PAYMENT
  RAW_PHOTOS_UPLOAD
  USER_SELECTION
  EDITOR_SELECTION
  FINAL_PHOTOS_UPLOAD
  WAITING_FOR_EXTRA_PAYMENT
  READY_TO_COMPLETE
  COMPLETED
  CANCELLED
}

enum Currency {
  HUF
  EUR
  USD
}

enum InvoiceType {
  NORMAL
  ADVANCE // előlegszámla
  FINAL // végszámla
  STORNO
}

enum InvoiceStatus {
  WAITING_FOR_PAYMENT
  SETTLED
  REFUNDED
}

enum PriceAdjustmentType {
  DISCOUNT
  DEDUCTION
  SURCHARGE
}

enum Package {
  MINI
  CLASSIC
  FAMILY
  PARTY
}

enum DecorSet {
  HOFEHER
  RETRO
}

// Client emails only — admin emails are never recorded in SentEmail.
enum EmailType {
  CLIENT_BOOKING_CONFIRMATION
  DEPOSIT_REQUEST
  REMINDER_ON_THE_DAY
  RESCHEDULE_NOTIFICATION
  IMAGE_SELECTION
  COMPLETED_PROJECT
}

enum SumupCheckoutAttemptStatus {
  INITIATED
  PENDING
  SUCCESSFUL
  CANCELLED
  FAILED
}
